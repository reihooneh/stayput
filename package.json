{
  "name": "stayput",
  "version": "1.0.0",
  "private": true,
  "description": "Simulates thousands of earthquakes on the floor you live on to find which furniture in a room will topple, where it lands, and what to anchor first",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "make wasm && node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/engine/*.test.mjs",
    "test:web": "node --test --test-concurrency=1 tests/web/*.test.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "playwright": "1.63.0",
    "three": "0.186.1"
  }
}
